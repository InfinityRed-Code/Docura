{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docura PDF",
  "version": "1.3.1",
  "identifier": "com.docura.pdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docura PDF",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "DocuraPDF.pdf",
        "description": "PDF-Dokument",
        "mimeType": "application/pdf"
      }
    ],
    "resources": {
      "resources/pdfium.dll": "resources/pdfium.dll",
      "../../../crates/pdf_fonts/fonts/README.md": "licenses/fonts/README.md",
      "../../../crates/pdf_fonts/fonts/roboto/OFL.txt": "licenses/fonts/Roboto-OFL.txt",
      "../../../crates/pdf_fonts/fonts/opensans/OFL.txt": "licenses/fonts/OpenSans-OFL.txt",
      "../../../crates/pdf_fonts/fonts/lato/OFL.txt": "licenses/fonts/Lato-OFL.txt",
      "../../../crates/pdf_fonts/fonts/montserrat/OFL.txt": "licenses/fonts/Montserrat-OFL.txt",
      "../../../crates/pdf_fonts/fonts/lora/OFL.txt": "licenses/fonts/Lora-OFL.txt",
      "../../../crates/pdf_fonts/fonts/sourceserif4/OFL.txt": "licenses/fonts/SourceSerif4-OFL.txt",
      "../../../crates/pdf_fonts/fonts/robotomono/OFL.txt": "licenses/fonts/RobotoMono-OFL.txt",
      "../../../crates/pdf_fonts/fonts/caveat/OFL.txt": "licenses/fonts/Caveat-OFL.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsi"
      }
    }
  }
}
