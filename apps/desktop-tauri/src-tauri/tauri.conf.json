{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docura PDF",
  "version": "1.1.1",
  "identifier": "com.docura.pdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docura PDF",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "DocuraPDF.pdf",
        "description": "PDF-Dokument",
        "mimeType": "application/pdf"
      }
    ],
    "resources": ["resources/pdfium.dll"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsi"
      }
    }
  }
}
