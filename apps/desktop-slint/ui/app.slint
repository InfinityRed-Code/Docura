import { Button, ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";

// First Slint port of the Docura PDF viewer (test-slint branch). The native
// Rust backend (pdf_core/pdf_pdfium) is called directly — no Tauri/webview
// IPC. This window is the rendering + navigation shell; feature parity with
// the Tauri UI (OCR, annotations, signing, …) is layered on from here.
export component AppWindow inherits Window {
    title: "Docura PDF — Slint";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: #2b2b2b;

    in property <image> page-image;
    in property <string> page-label: "—";
    in property <string> zoom-label: "100%";
    in property <string> status: "Open a PDF to begin";
    in property <bool> has-doc: false;

    callback open-clicked();
    callback prev-clicked();
    callback next-clicked();
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Toolbar
        Rectangle {
            height: 48px;
            background: #1e1e1e;
            HorizontalBox {
                padding: 8px;
                spacing: 6px;
                alignment: start;
                Button { text: "Open…"; clicked => { root.open-clicked(); } }
                Rectangle { width: 8px; }
                Button { text: "◀"; enabled: root.has-doc; clicked => { root.prev-clicked(); } }
                Text {
                    text: root.page-label;
                    color: #dddddd;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 90px;
                }
                Button { text: "▶"; enabled: root.has-doc; clicked => { root.next-clicked(); } }
                Rectangle { width: 8px; }
                Button { text: "−"; enabled: root.has-doc; clicked => { root.zoom-out(); } }
                Button {
                    text: root.zoom-label;
                    enabled: root.has-doc;
                    clicked => { root.zoom-reset(); }
                }
                Button { text: "+"; enabled: root.has-doc; clicked => { root.zoom-in(); } }
            }
        }

        // Page view
        ScrollView {
            viewport-width: root.page-image.width * 1px;
            viewport-height: root.page-image.height * 1px;
            Image {
                source: root.page-image;
                image-fit: ImageFit.preserve;
            }
        }

        // Status bar
        Rectangle {
            height: 26px;
            background: #1e1e1e;
            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: root.status;
                    color: #aaaaaa;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
