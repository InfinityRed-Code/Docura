import { Button, ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";

// One row = one page. `w`/`h` are the on-screen size (reserved for layout so
// the scrollbar is correct before the bitmap exists); `img` is filled lazily
// when the page scrolls into view.
struct PageRow {
    w: length,
    h: length,
    img: image,
}

export component AppWindow inherits Window {
    title: "Docura PDF — Slint";
    preferred-width: 1100px;
    preferred-height: 850px;
    background: #333333;

    in property <[PageRow]> pages;
    in property <string> info: "Open a PDF";
    in property <bool> has-doc: false;

    callback open-clicked();
    callback zoom-in();
    callback zoom-out();
    // Fired when a page delegate is realised (scrolled into view) — the Rust
    // side renders that page on a worker thread and fills its image.
    callback request-render(int);

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: #1e1e1e;
            HorizontalBox {
                padding: 8px;
                spacing: 6px;
                alignment: start;
                Button { text: "Open…"; clicked => { root.open-clicked(); } }
                Button { text: "−"; enabled: has-doc; clicked => { root.zoom-out(); } }
                Button { text: "+"; enabled: has-doc; clicked => { root.zoom-in(); } }
                Text {
                    text: info;
                    color: #dddddd;
                    vertical-alignment: center;
                }
            }
        }

        ListView {
            for row[i] in pages: Rectangle {
                height: row.h + 14px;
                background: transparent;
                page := Rectangle {
                    y: 7px;
                    width: row.w;
                    height: row.h;
                    x: (parent.width - self.width) / 2;
                    background: white;
                    drop-shadow-blur: 7px;
                    drop-shadow-color: #00000055;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: row.img;
                        image-rendering: smooth;
                    }
                    init => {
                        root.request-render(i);
                    }
                }
            }
        }
    }
}
